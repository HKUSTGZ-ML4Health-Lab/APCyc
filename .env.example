# Private assets stay outside the source repository. Export variables in your shell;
# this file is a template and is not loaded automatically.
APCYC_BUNDLE=
APCYC_CONFIG=
APCYC_COMPARISON_BUNDLE=
APCYC_COMPARISON_CONFIG=
APCYC_PRIVATE_ROOT=
APCYC_INPUT=
# Smoke repeat gate: auto requires byte equality on CPU, records it on CUDA.
# Set 1 to require equality explicitly, or 0 to report without enforcing it.
APCYC_REQUIRE_BITWISE=auto
